# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# Leave POSTGRES_HOST as `postgres` (the local container started by this same
# docker-compose.yml) for local dev. For production, point it at a managed Postgres
# instead -- e.g. an Azure Database for PostgreSQL Flexible Server hostname -- and set
# POSTGRES_SSL_MODE=Require (managed providers generally reject plaintext connections;
# Trust Server Certificate=true is always sent, which is fine since these providers use
# publicly-trusted CA certs, not self-signed ones). The `schoolerp` database and its 12
# per-service schemas (scripts/01-schemas.sql) must already exist on the target server --
# only tables are created automatically (each service's own `db.Database.Migrate()`).
POSTGRES_HOST=postgres
POSTGRES_SSL_MODE=Disable
POSTGRES_USER=schoolerp
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=schoolerp

RABBITMQ_USER=schoolerp
RABBITMQ_PASSWORD=change_me_strong_password

JWT_SIGNING_KEY=change_me_min_32_char_random_secret_key_here
JWT_ISSUER=SchoolERP.Identity
JWT_AUDIENCE=SchoolERP.Clients

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me

# Points at the azurite container in docker-compose.yml (Azure Storage emulator) by
# default -- swap for a real Azure Storage connection string in production.
# AZURE_BLOB_PUBLIC_BASE_URL rewrites SAS download URLs so they're reachable from the
# browser (see AzureBlobStorageService.RewriteForPublicAccess in Fee/Student/Examination.API);
# leave unset in production, where the real Storage account is already browser-reachable.
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_BLOB_PUBLIC_BASE_URL=http://localhost:10000/devstoreaccount1

# The Angular dev server's origin -- the gateway's CORS policy only allows this origin
# to call the API from a browser. Update if your frontend runs on a different port/host.
FRONTEND_URL=http://localhost:4200

# Public domain for the Caddy reverse proxy (see Caddyfile) to request a real Let's
# Encrypt certificate for -- e.g. api.yourschool.com. Requires: DNS actually pointing
# at this server's IP, and ports 80/443 reachable from the internet (for the ACME
# HTTP-01 challenge). Leave unset/as `localhost` until you have both; Caddy then uses
# a local/internal cert instead of attempting (and failing) real ACME issuance.
DOMAIN=localhost
