# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# TiDB Cloud connection -- every module's database lives on this one cluster (one TiDB
# database per module: identity, student, staff, ...), created by the app's migrations. Get these from the TiDB
# Cloud console: cluster overview -> Connect. TIDB_HOST is the cluster's gateway
# hostname (e.g. gateway01.<region>.prod.aws.tidbcloud.com), port is always 4000,
# and the connection always requires TLS (SslMode=VerifyFull in docker-compose.yml).
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=

# Local development without TiDB Cloud or Azure: uncomment these instead of the values
# above to run TiDB and Azurite containers (profiles local-db and local-storage in
# docker-compose.yml). Never in production.
# COMPOSE_PROFILES=local-db,local-storage
# TIDB_HOST=tidb
# TIDB_USER=root
# TIDB_PASSWORD=
# TIDB_SSL_MODE=None

# Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=change_me_min_32_char_random_secret_key_here
JWT_ISSUER=SchoolERP.Identity
JWT_AUDIENCE=SchoolERP.Clients

# Password the school-owner (SuperAdmin) account is seeded with on FIRST boot only --
# ignored once the account exists. Leave blank to have a random password generated and
# printed once in the app's container logs instead.
OWNER_USERNAME=
OWNER_PASSWORD=

# Where generated PDFs (receipts, report cards, certificates) are kept: "Database" (default,
# free -- a "files" database on the same server) or "AzureBlob" (the settings below).
FILE_STORAGE_PROVIDER=Database
# Only used with FILE_STORAGE_PROVIDER=AzureBlob.
# Points at the azurite container (local-storage profile) by default -- use a real Azure
# Storage connection string in production. AZURE_BLOB_PUBLIC_BASE_URL rewrites SAS download
# URLs so they're reachable from the browser (see DataAccess/Storage/AzureBlobStorageService);
# leave it unset in production, where the Storage account is already browser-reachable.
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_BLOB_PUBLIC_BASE_URL=http://localhost:10000/devstoreaccount1

# Optional real email delivery for notifications (any SMTP relay: Gmail/Workspace app
# password, SES, SendGrid, ...). Leave SMTP_HOST empty to only log notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# The frontend's origin -- the app's CORS policy only allows this origin
# to call the API from a browser. Update if your frontend runs on a different port/host.
FRONTEND_URL=http://localhost:4200

# Public domain for the Caddy reverse proxy (see Caddyfile) to request a real Let's
# Encrypt certificate for -- e.g. api.yourschool.com. Requires: DNS actually pointing
# at this server's IP, and ports 80/443 reachable from the internet (for the ACME
# HTTP-01 challenge). Leave unset/as `localhost` until you have both; Caddy then uses
# a local/internal cert instead of attempting (and failing) real ACME issuance.
DOMAIN=localhost

# Optional: ship logs to Seq (start it with the `seq` profile, then set SEQ_URL=http://seq:5341).
SEQ_URL=
