{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Issuer": "SchoolERP.Identity",
    "Audience": "SchoolERP.Clients",
    "SigningKey": "CHANGE_ME_USE_DOTNET_USER_SECRETS_OR_KEYVAULT_MIN_32_CHARS"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "auth-strict",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-swagger-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "standard",
        "Match": { "Path": "/identity/swagger/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },

      "student-verify-route": {
        "ClusterId": "student-cluster",
        "RateLimiterPolicy": "standard",
