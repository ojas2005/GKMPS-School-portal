<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business tier: services (rules, workflows, authorization-aware logic), DTOs, token
       issuing, PDF documents and in-process event handlers. Talks to data only through
       the DataAccess tier's repositories. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SchoolERP.Business</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SchoolERP.DataAccess/SchoolERP.DataAccess.csproj" />
  </ItemGroup>

  <!-- Same implicit usings the Web SDK gave these files when they lived in the API projects. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

</Project>
