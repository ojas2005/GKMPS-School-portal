<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SchoolERP.Shared</RootNamespace>
  </PropertyGroup>

  <!-- Needed for IExceptionHandler/HttpContext (GlobalExceptionHandler) since this is
       otherwise a plain class library, not a web project. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Same Serilog.AspNetCore version every service already references directly, so
       there's exactly one resolved version across the whole solution, plus the Seq
       sink, added here once instead of in all 12 service .csproj files. -->
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="8.0.0" />
  </ItemGroup>

</Project>
